# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Dominio(s) del frontend, separados por coma si hay más de uno. Se usa para dos
# cosas con la misma variable: (1) CORS — qué orígenes puede aceptar la API además
# de localhost:5173, y (2) el link del correo de recuperar contraseña (toma el
# primero de la lista). En producción: la URL de Vercel (ej. https://encomiexpress.vercel.app).
FRONTEND_URLS=

# ─── Base de datos (PostgreSQL) ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=encomiexpress
DB_USER=postgres
DB_PASSWORD=
# En producción con Supabase (o cualquier Postgres administrado): DB_SSL=true
# Localmente dejar sin definir (sin SSL).
DB_SSL=

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Usar claves largas y aleatorias distintas entre sí
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=24h

# ─── Seed inicial (npm run db:seed) ───────────────────────────────────────────
# Contraseña del usuario admin@encomiexpress.com, creado por src/config/seed.js
# (y por POST /api/seed, solo en desarrollo). OBLIGATORIA — sin valor por
# defecto, ni siquiera en local: si se deja vacía, el seed falla con un error
# en vez de usar una contraseña conocida. Ponle cualquier valor aquí (tu propio
# .env nunca se sube a git) antes de correr el seed la primera vez.
ADMIN_INITIAL_PASSWORD=

# ─── Cloudinary (almacenamiento de soportes/imágenes) ────────────────────────
# Obtener desde https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (Nodemailer — recuperación de contraseña) ─────────────────────────
# Ejemplo con Gmail: EMAIL_HOST=smtp.gmail.com | EMAIL_PORT=587
# Requiere una "contraseña de aplicación" si usas Gmail con 2FA
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
