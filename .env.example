# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Base de datos (PostgreSQL) ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=encomiexpress
DB_USER=postgres
DB_PASSWORD=
# En producción con Supabase (o cualquier Postgres administrado): DB_SSL=true
# Localmente dejar sin definir (sin SSL).
DB_SSL=

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Usar claves largas y aleatorias distintas entre sí
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=24h

# ─── Seed inicial (npm run db:seed) ───────────────────────────────────────────
# Contraseña del usuario admin@encomiexpress.com creado por src/config/seed.js.
# Solo se usa una vez, al correr el script. Si se deja vacía, usa 'admin123'
# como conveniencia en desarrollo (con aviso en consola) — en producción SIEMPRE
# definir una contraseña real acá antes de correr el seed.
ADMIN_INITIAL_PASSWORD=

# ─── Cloudinary (almacenamiento de soportes/imágenes) ────────────────────────
# Obtener desde https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (Nodemailer — recuperación de contraseña) ─────────────────────────
# Ejemplo con Gmail: EMAIL_HOST=smtp.gmail.com | EMAIL_PORT=587
# Requiere una "contraseña de aplicación" si usas Gmail con 2FA
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
